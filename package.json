{
  "name": "quadra",
  "version": "0.15.1",
  "description": "Quadra — computo metrico, elenco prezzi e contabilità dei lavori pubblici, offline-first (derivato da Open E.Hub)",
  "main": "main.js",
  "author": "Galax65 (basato su Open E.Hub di Davide Bottura)",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Galax65/quadra.git"
  },
  "bugs": {
    "url": "https://github.com/Galax65/quadra/issues"
  },
  "homepage": "https://github.com/Galax65/quadra#readme",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prestart": "npm run build:web",
    "start": "electron .",
    "serve": "node scripts/serve.mjs",
    "pretest": "npm run typecheck",
    "prebuild": "npm run test",
    "build": "npm run build:web",
    "build:web": "node scripts/build-web.mjs",
    "build:amministrazione": "TOOL=amministrazione vite build && node scripts/place-builds.mjs",
    "build:hub": "TOOL=hub vite build && node scripts/place-builds.mjs",
    "build:prezzari": "vite-node scripts/build-prezzari.ts",
    "quadra": "vite-node scripts/cli/quadra.run.ts",
    "bundle:prezzari": "node scripts/bundle-prezzari.mjs",
    "bump": "node scripts/bump.mjs",
    "release": "node scripts/release.mjs",
    "sync:versions": "node scripts/bump.mjs --sync",
    "sync:readme": "node scripts/sync-readme.mjs",
    "sync:docs": "vite-node scripts/sync-docs.run.ts",
    "postinstall": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"src/tools/**/styles/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild:mac": "npm run build:web && npm run bundle:prezzari",
    "build:mac": "electron-builder --mac",
    "prebuild:win": "npm run build:web && npm run bundle:prezzari",
    "build:win": "electron-builder --win",
    "predist:win": "npm run build",
    "dist:win": "npm run build:win",
    "prebuild:all": "npm run build:web && npm run bundle:prezzari",
    "build:all": "electron-builder --mac --win"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.18.0",
    "fast-xml-parser": "^5.12.1",
    "jsdom": "^31.0.1",
    "jszip": "^3.10.2",
    "opentype.js": "^2.0.0",
    "stylelint": "^18.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1",
    "wawoff2": "^2.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "it.galax65.quadra",
    "productName": "Quadra",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.html",
      "versions.js",
      "main.js",
      "preload.js",
      "vendor/**",
      "assets/**",
      "prezzari/_bundle/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon-win.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "fsevents": false
  }
}
